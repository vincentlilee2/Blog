# 依赖
node_modules/

# 构建缓存
dist/
.astro/
admin/admin-dist/

# 本地站点配置（含个人信息，不进仓库）
site-config.json
# 多用户子站 base 前缀（个人部署路径，不进仓库）
admin/server-config.json
# 部署配置（含服务器 IP / 域名，私密，不进仓库）
deploy-config.json

# 环境变量 / 密钥
.env
.env.*

# 媒体资源（默认全部忽略：个人照片/头像/微信码等私人内容不进开源仓）
# 仅在白名单中放行仓库自带的品牌素材（电子名片用）
public/media/**
!public/media/images/card-logo.png
!public/media/images/card-long.png
!public/media/images/card-og.png
!public/media/images/card-og-square.png
!public/media/images/card-og-square.jpg
!public/media/images/card-og-v2.jpg

# 个人博客文章（本地私有，不进开源仓）
# 开源仓的示例文章在 example-posts/（README 有说明如何接入）
src/content/blog/**
!src/content/blog/.gitkeep

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp
