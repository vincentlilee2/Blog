---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).filter((p) => p.data.published);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout title="标签 · MemoryGarden Blog">
  <h1 class="page-title">标签</h1>
  <div class="tag-cloud" style="font-size:1rem;">
    {
      tags.map((tag) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
          #{tag}
        </a>
      ))
    }
  </div>
</Layout>
